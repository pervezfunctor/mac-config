#!/usr/bin/env python3
"""Select and apply one coherent theme across the developer environment."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


DEFAULT_ROOT = Path(__file__).resolve().parent
ROOT = Path(os.environ.get("THEME_SWITCHER_ROOT", DEFAULT_ROOT)).resolve()
MANIFEST = ROOT / "themes.json"
CURRENT = ROOT / ".theme-current"
REQUIRED_THEME_FIELDS = {
    "appearance",
    "ghostty",
    "kitty",
    "zed",
    "editor",
    "editor_extension",
    "zed_extension",
    "tuicr",
    "herdr",
    "nvim_plugin",
    "nvim_name",
    "nvim_colorscheme",
    "nvim_opts",
}


def info(message: str) -> None:
    print(f"  {message}")


def warn(message: str) -> None:
    print(f"warning: {message}", file=sys.stderr)


def read_text(path: Path) -> str:
    try:
        return path.read_text()
    except FileNotFoundError as error:
        raise RuntimeError(f"missing config: {path}") from error


def atomic_write(path: Path, content: str, *, dry_run: bool) -> bool:
    old = path.read_text() if path.exists() else None
    if old == content:
        info(f"unchanged {display_path(path)}")
        return False
    if dry_run:
        info(f"would update {display_path(path)}")
        return True

    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode if path.exists() else None
    with tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as temporary:
        temporary.write(content)
        temporary.flush()
        os.fsync(temporary.fileno())
        temporary_path = Path(temporary.name)
    if mode is not None:
        os.chmod(temporary_path, mode)
    os.replace(temporary_path, path)
    info(f"updated {display_path(path)}")
    return True


def display_path(path: Path) -> str:
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def same_file(first: Path, second: Path) -> bool:
    try:
        return first.exists() and second.exists() and os.path.samefile(first, second)
    except OSError:
        return False


def replace_setting(text: str, key: str, value: str, separator: str) -> str:
    pattern = re.compile(rf"(?m)^(\s*{re.escape(key)}\s*{re.escape(separator)}\s*).*$")
    replacement = lambda match: f"{match.group(1)}{value}"
    if pattern.search(text):
        return pattern.sub(replacement, text, count=1)
    suffix = "" if text.endswith("\n") else "\n"
    return f"{text}{suffix}{key} {separator} {value}\n"


def replace_json_string(text: str, key: str, value: str) -> str:
    pattern = re.compile(rf'(\"{re.escape(key)}\"\s*:\s*)\"(?:\\.|[^\"])*\"')
    encoded = json.dumps(value, ensure_ascii=False)
    if pattern.search(text):
        return pattern.sub(lambda match: match.group(1) + encoded, text, count=1)

    closing = text.rfind("}")
    if closing < 0:
        raise RuntimeError(f"cannot add {key!r}: settings file is not an object")
    prefix = text[:closing].rstrip()
    comma = "" if prefix.endswith("{") else ","
    return f'{prefix}{comma}\n  {json.dumps(key, ensure_ascii=False)}: {encoded}\n{ text[closing:] }'


def replace_json_bool(text: str, key: str, value: bool) -> str:
    pattern = re.compile(rf'(\"{re.escape(key)}\"\s*:\s*)(?:true|false)')
    encoded = "true" if value else "false"
    if pattern.search(text):
        return pattern.sub(lambda match: match.group(1) + encoded, text, count=1)
    closing = text.rfind("}")
    if closing < 0:
        raise RuntimeError(f"cannot add {key!r}: settings file is not an object")
    prefix = text[:closing].rstrip()
    comma = "" if prefix.endswith("{") else ","
    return f'{prefix}{comma}\n  {json.dumps(key)}: {encoded}\n{text[closing:]}'


def enable_json_object_flag(text: str, object_key: str, flag: str) -> str:
    start, end = object_span(text, object_key)
    block = text[start:end]
    pattern = re.compile(rf'(\"{re.escape(flag)}\"\s*:\s*)(?:true|false)')
    if pattern.search(block):
        block = pattern.sub(lambda match: match.group(1) + "true", block, count=1)
    else:
        closing_indent_match = re.search(r"(?m)^(\s*)\}\s*$", block)
        if not closing_indent_match:
            raise RuntimeError(f"could not update {object_key!r} object")
        closing_indent = closing_indent_match.group(1)
        item_indent = closing_indent + "  "
        insertion = f'{item_indent}{json.dumps(flag)}: true,\n'
        block = block[: closing_indent_match.start()] + insertion + block[closing_indent_match.start() :]
    return text[:start] + block + text[end:]


def object_span(text: str, key: str) -> tuple[int, int]:
    match = re.search(rf'\"{re.escape(key)}\"\s*:\s*\{{', text)
    if not match:
        raise RuntimeError(f"could not find {key!r} object")
    start = text.find("{", match.start())
    depth = 0
    in_string = False
    escaped = False
    for index in range(start, len(text)):
        char = text[index]
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            continue
        if char == '"':
            in_string = True
        elif char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return start, index + 1
    raise RuntimeError(f"unterminated {key!r} object")


def update_zed(
    path: Path, theme: str, appearance: str, extension: str, dry_run: bool
) -> None:
    text = read_text(path)
    if extension:
        text = enable_json_object_flag(text, "auto_install_extensions", extension)
    start, end = object_span(text, "theme")
    block = text[start:end]
    for key, value in (("mode", appearance), ("light", theme), ("dark", theme)):
        block = replace_json_string(block, key, value)
    atomic_write(path, text[:start] + block + text[end:], dry_run=dry_run)


def update_editor(path: Path, theme: str, dry_run: bool) -> None:
    text = read_text(path)
    atomic_write(path, replace_json_string(text, "workbench.colorTheme", theme), dry_run=dry_run)


def update_cursor(path: Path, theme: str, dry_run: bool) -> None:
    text = read_text(path)
    text = replace_json_string(text, "workbench.colorTheme", theme)
    text = replace_json_bool(text, "window.autoDetectColorScheme", False)
    atomic_write(path, text, dry_run=dry_run)


def update_live_editor(
    repo_path: Path, live_path: Path, theme: str, dry_run: bool, *, cursor: bool = False
) -> None:
    if same_file(repo_path, live_path):
        return
    if not live_path.exists() and not live_path.parent.is_dir():
        info(f"skipped live {live_path} (application config not found)")
        return
    if cursor:
        update_cursor(live_path, theme, dry_run)
    else:
        update_editor(live_path, theme, dry_run)


def update_nvim(theme: dict[str, str], dry_run: bool) -> None:
    content = f'''-- Generated by theme-switcher. Do not edit by hand.
return {{
  colorscheme = {json.dumps(theme["nvim_colorscheme"])},
  plugin = {{
    {json.dumps(theme["nvim_plugin"])},
    name = {json.dumps(theme["nvim_name"])},
    priority = 1000,
    opts = {theme["nvim_opts"]},
  }},
}}
'''
    atomic_write(ROOT / "config/nvim/lua/theme.lua", content, dry_run=dry_run)


def update_kitty(theme_name: str, dry_run: bool) -> None:
    config = ROOT / "config/kitty/kitty.conf"
    text = read_text(config)
    text = re.sub(
        r"(?m)(^# BEGIN_KITTY_THEME\n)# .*?(\ninclude current-theme\.conf\n# END_KITTY_THEME$)",
        rf"\1# {theme_name}\2",
        text,
        count=1,
    )
    atomic_write(config, text, dry_run=dry_run)

    if dry_run:
        info(f"would generate config/kitty/current-theme.conf ({theme_name})")
        return
    kitten = shutil.which("kitten")
    if not kitten:
        warn("kitten is unavailable; kept the existing Kitty palette")
        return
    result = subprocess.run(
        [kitten, "themes", "--dump-theme", theme_name],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        detail = result.stderr.strip() or "theme produced no output"
        warn(f"could not generate Kitty theme {theme_name!r}: {detail}")
        return
    palette = result.stdout.rstrip() + "\n"
    repo_palette = ROOT / "config/kitty/current-theme.conf"
    atomic_write(repo_palette, palette, dry_run=False)
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    live_palette = config_home / "kitty/current-theme.conf"
    if not same_file(repo_palette, live_palette) and (
        live_palette.exists() or live_palette.parent.is_dir()
    ):
        atomic_write(live_palette, palette, dry_run=False)


def reload_kitty(dry_run: bool) -> None:
    if os.environ.get("THEME_SWITCHER_NO_RELOAD") == "1":
        return
    if dry_run:
        info("would reload running Kitty instances")
        return
    pkill = shutil.which("pkill")
    if not pkill:
        warn("pkill is unavailable; reload Kitty manually")
        return
    result = subprocess.run(
        [pkill, "-USR1", "-x", "kitty"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode == 0:
        info("reloaded running Kitty instances")


def reload_ghostty(dry_run: bool) -> None:
    if os.environ.get("THEME_SWITCHER_NO_RELOAD") == "1":
        return
    if dry_run:
        info("would reload running Ghostty instances")
        return
    pkill = shutil.which("pkill")
    if not pkill:
        warn("pkill is unavailable; reload Ghostty manually")
        return
    result = subprocess.run(
        [pkill, "-USR2", "-x", "ghostty"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode == 0:
        info("reloaded running Ghostty instances")


def editor_executable(command: str) -> str | None:
    executable = shutil.which(command)
    if executable:
        return executable
    if sys.platform != "darwin":
        return None
    app_binaries = {
        "code": "Visual Studio Code.app/Contents/Resources/app/bin/code",
        "cursor": "Cursor.app/Contents/Resources/app/bin/cursor",
    }
    relative = app_binaries.get(command)
    if not relative:
        return None
    for applications in (Path("/Applications"), Path.home() / "Applications"):
        candidate = applications / relative
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def ensure_extension(command: str, extension: str, dry_run: bool) -> None:
    executable = editor_executable(command)
    if not executable:
        info(f"skipped {command} extension (command not installed)")
        return
    listed = subprocess.run(
        [executable, "--list-extensions"], text=True, capture_output=True, check=False
    )
    installed = {line.strip().lower() for line in listed.stdout.splitlines()}
    if extension.lower() in installed:
        info(f"unchanged {command} extension {extension}")
        return
    if dry_run:
        info(f"would install {command} extension {extension}")
        return
    result = subprocess.run([executable, "--install-extension", extension], check=False)
    if result.returncode != 0:
        warn(f"failed to install {extension} with {command}")
    else:
        info(f"installed {command} extension {extension}")


def choose_theme(names: list[str]) -> str:
    fzf = shutil.which("fzf")
    if not fzf:
        raise RuntimeError("fzf is required for interactive selection; use --theme NAME")
    result = subprocess.run(
        [fzf, "--prompt=Theme> ", "--height=~40%", "--layout=reverse", "--border"],
        input="\n".join(names) + "\n",
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode == 130 or not result.stdout.strip():
        raise KeyboardInterrupt
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "fzf failed")
    return result.stdout.strip()


def current_theme() -> str:
    try:
        return CURRENT.read_text().strip()
    except FileNotFoundError as error:
        raise RuntimeError(f"current theme state is missing: {CURRENT}") from error


def load_themes() -> dict[str, dict[str, str]]:
    themes = json.loads(MANIFEST.read_text())
    if not isinstance(themes, dict) or not themes:
        raise RuntimeError("themes.json must contain at least one theme")
    for name, mapping in themes.items():
        if not isinstance(name, str) or not isinstance(mapping, dict):
            raise RuntimeError("each theme must be a named JSON object")
        missing = REQUIRED_THEME_FIELDS - mapping.keys()
        if missing:
            raise RuntimeError(f"theme {name!r} is missing: {', '.join(sorted(missing))}")
        if any(not isinstance(mapping[field], str) for field in REQUIRED_THEME_FIELDS):
            raise RuntimeError(f"theme {name!r} mappings must all be strings")
    return themes


def apply_theme(name: str, theme: dict[str, str], dry_run: bool) -> None:
    ensure_extension("code", theme["editor_extension"], dry_run)
    ensure_extension("cursor", theme["editor_extension"], dry_run)

    operations = []
    ghostty = ROOT / "config/ghostty/config"
    operations.append(
        lambda: atomic_write(
            ghostty,
            replace_setting(read_text(ghostty), "theme", theme["ghostty"], "="),
            dry_run=dry_run,
        )
    )
    operations.append(lambda: update_kitty(theme["kitty"], dry_run))
    operations.append(
        lambda: update_zed(
            ROOT / "config/zed/settings.json",
            theme["zed"],
            theme["appearance"],
            theme["zed_extension"],
            dry_run,
        )
    )
    vscode = ROOT / "vscode/settings.json"
    cursor = ROOT / "cursor/settings.json"
    operations.append(lambda: update_editor(vscode, theme["editor"], dry_run))
    operations.append(lambda: update_cursor(cursor, theme["editor"], dry_run))
    operations.append(
        lambda: update_live_editor(
            vscode,
            Path.home() / "Library/Application Support/Code/User/settings.json",
            theme["editor"],
            dry_run,
        )
    )
    operations.append(
        lambda: update_live_editor(
            cursor,
            Path.home() / "Library/Application Support/Cursor/User/settings.json",
            theme["editor"],
            dry_run,
            cursor=True,
        )
    )

    tuicr = ROOT / "config/tuicr/config.toml"
    operations.append(
        lambda: atomic_write(
            tuicr,
            replace_setting(
                replace_setting(read_text(tuicr), "theme", json.dumps(theme["tuicr"]), "="),
                "appearance",
                json.dumps(theme["appearance"]),
                "=",
            ),
            dry_run=dry_run,
        )
    )
    herdr = ROOT / "config/herdr/config.toml"
    operations.append(
        lambda: atomic_write(
            herdr,
            replace_setting(read_text(herdr), "name", json.dumps(theme["herdr"]), "="),
            dry_run=dry_run,
        )
    )
    operations.append(lambda: update_nvim(theme, dry_run))

    failures = 0
    for operation in operations:
        try:
            operation()
        except (OSError, RuntimeError) as error:
            failures += 1
            warn(str(error))

    reload_kitty(dry_run)
    reload_ghostty(dry_run)
    if not dry_run:
        atomic_write(CURRENT, f"{name}\n", dry_run=False)
        herdr = shutil.which("herdr")
        if herdr:
            subprocess.run(
                [herdr, "server", "reload-config"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
    if failures:
        raise RuntimeError(f"{failures} config update(s) failed")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument("--theme", metavar="NAME", help="apply NAME without opening fzf")
    selection.add_argument("--apply-current", action="store_true", help="reapply the saved theme")
    parser.add_argument("--list", action="store_true", help="list supported themes and exit")
    parser.add_argument("--dry-run", action="store_true", help="show changes without writing")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        themes = load_themes()
        if args.list:
            print("\n".join(themes))
            return 0
        name = current_theme() if args.apply_current else args.theme
        if name is None:
            name = choose_theme(list(themes))
        if name not in themes:
            choices = ", ".join(themes)
            raise RuntimeError(f"unknown theme {name!r}; choose one of: {choices}")
        print(f"Applying {name}{' (dry run)' if args.dry_run else ''}")
        apply_theme(name, themes[name], args.dry_run)
        print(f"Theme applied: {name}")
        return 0
    except KeyboardInterrupt:
        print("Theme selection cancelled.", file=sys.stderr)
        return 130
    except (OSError, ValueError, RuntimeError) as error:
        print(f"theme-switcher: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
