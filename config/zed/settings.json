{
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "glm-acp-agent": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },

  "vim_mode": false,
  "session": {
    "trust_all_worktrees": true,
  },

  "auto_install_extensions": {
    "bash": true,
    "fish": true,
    "git-firefly": true,
    "make": true,
    "neocmake": true,
    "nu": true,
    "toml": true,
  },

  "tab_size": 2,
  "cli_default_open_behavior": "new_window",

  "ui_font_size": 16,
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 15,
  },
  "markdown_preview_font_family": "JetBrainsMono Nerd Font",
  "markdown_preview_code_font_family": "JetBrainsMono Nerd Font",
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Dark",
    "dark": "Gruvbox Dark",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
}
