{
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "glm-acp-agent": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },

  "vim_mode": false,
  "session": {
    "trust_all_worktrees": true,
  },

  "auto_install_extensions": {
    "bash": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "fish": true,
    "git-firefly": true,
    "make": true,
    "neocmake": true,
    "nu": true,
    "toml": true,
  },

  "tab_size": 2,
  "cli_default_open_behavior": "new_window",

  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "Ayu Mirage",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
}
