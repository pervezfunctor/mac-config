#!/bin/sh

set -eu

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

frm() {
  if [ -e "$1" ]; then
    log "Trashing $1..."
    trash "$1"
  fi
}

readonly REPO_NAME="mac-config"
readonly DOT_DIR="$HOME/.${REPO_NAME}"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

log() { printf "${GREEN}✔${RESET} %s\n\n" "$*"; }
warn() { printf "${YELLOW}${BOLD}⚠${RESET} %s\n\n" "$*" >&2; }
die() {
  printf "${RED}${BOLD}✖${RESET} %s\n\n" "$*" >&2
  exit 1
}

xcode_cli_tools() {
  if xcode-select -p >/dev/null 2>&1; then
    return
  fi

  log "Requesting Xcode Command Line Tools installation..."
  if ! xcode-select --install; then
    warn "The installer may already be open or installation may be in progress."
  fi
  warn "Complete the Xcode Command Line Tools installation, then run mac-setup again."
  exit 0
}

brew_upgrade() {
  has_cmd brew || die "brew not found."
  log "Upgrading brew packages..."
  brew upgrade -y
}

brew_install() {
  if has_cmd brew; then
    log "Updating brew..."
    brew update
    return
  fi

  log "Installing homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
}

zsh_config() {
  if [ -L ~/.zshrc ] && [ ! -e ~/.zshrc ]; then
    rm ~/.zshrc
  fi
  touch ~/.zshrc
  readonly snippet="for file in ~/.config/zsh/conf.d/*.zsh(N); do source \"\$file\"; done"
  if ! grep -qF "$snippet" ~/.zshrc; then
    log "Sourcing ~/.config/zsh/conf.d/*.zsh in ${HOME}/.zshrc"
    echo "$snippet" >>~/.zshrc
  fi
}

nvim_config() {
  has_cmd nvim || brew install -y -q neovim

  if [ ! -e ~/.config/nvim/init.lua ]; then
    frm ~/.config/nvim
    log "Cloning Astronvim..."
    git clone --depth 1 https://github.com/AstroNvim/template ~/.config/nvim
    frm ~/.config/nvim/.git
    frm ~/.local/share/nvim
    frm ~/.local/state/nvim
    frm ~/.cache/nvim
    log "Astronvim installed."
  else
    log "$HOME/.config/nvim already exists. Skipping installation."
  fi
}

safe_ln() {
  if [ "$#" -ne 2 ]; then
    warn "Usage: safe_ln <source_file> <destination_file>"
    return 1
  fi
  source_file=$1
  destination_file=$2

  : "${BACKUP_RUN_ID:=$(date +%Y-%m-%d_%H-%M-%S)-$$}"
  case "$destination_file" in
  "$HOME"/*) backup_relative_path=${destination_file#"$HOME/"} ;;
  *) backup_relative_path=${destination_file#/} ;;
  esac
  backup_file="$HOME/.mac-config-backup/$BACKUP_RUN_ID/$backup_relative_path"

  if [ ! -f "$source_file" ] || [ -L "$source_file" ]; then
    warn "Source is not a regular file: $source_file"
    return 1
  fi

  if [ -L "$destination_file" ]; then
    if [ -e "$destination_file" ] && [ "$source_file" -ef "$destination_file" ]; then
      return
    fi
    warn "Refusing to replace symlink: $destination_file"
    return 1
  fi

  backed_up=false
  if [ -e "$destination_file" ]; then
    if [ ! -f "$destination_file" ]; then
      warn "Destination is not a regular file: $destination_file"
      return 1
    fi
    if [ -e "$backup_file" ] || [ -L "$backup_file" ]; then
      warn "Backup already exists: $backup_file"
      return 1
    fi
    if ! mkdir -p "$(dirname "$backup_file")"; then
      warn "Failed to create backup directory for $destination_file"
      return 1
    fi
    if ! mv "$destination_file" "$backup_file"; then
      warn "Failed to back up $destination_file"
      return 1
    fi
    backed_up=true
    log "Backed up $destination_file -> $backup_file"
  fi

  if ! mkdir -p "$(dirname "$destination_file")"; then
    if [ "$backed_up" = true ] && ! mv "$backup_file" "$destination_file"; then
      warn "Failed to restore $destination_file from $backup_file"
    fi
    warn "Failed to create destination directory for $destination_file"
    return 1
  fi
  if ! ln -s "$source_file" "$destination_file"; then
    if [ "$backed_up" = true ] && ! mv "$backup_file" "$destination_file"; then
      warn "Failed to restore $destination_file from $backup_file"
    fi
    warn "Failed to link $source_file -> $destination_file"
    return 1
  fi
}

link_config() {
  if [ "$#" -ne 2 ]; then
    warn "Usage: link_config <rel_path> <dest_dir>"
    return 1
  fi
  REL_PATH=$1
  DEST=$2
  : "${DOT_DIR:?DOT_DIR is not set}"
  SRC="$DOT_DIR/$REL_PATH"

  if [ ! -d "$SRC" ]; then
    warn "Source directory not found: $SRC"
    return 1
  fi

  log "Linking $REL_PATH/ -> $DEST/"
  find "$SRC" -type f | while IFS= read -r source_file; do
    relative_path=${source_file#"$SRC/"}
    if ! safe_ln \
      "$source_file" \
      "$DEST/$relative_path"; then
      continue
    fi
  done
}

config_setup() {
  if ! link_config config "$HOME/.config"; then
    :
  fi
  if ! link_config vscode "$HOME/Library/Application Support/Code/User"; then
    :
  fi

  zsh_config

  if has_cmd code && ! code --list-extensions | grep -qi "teabyii.ayu"; then
    code --install-extension "teabyii.ayu"
  fi

  if has_cmd kitten; then
    kitten themes --reload-in=none "Ayu Mirage"
  fi

}

packages_install() {
  brew_install
  brew tap BarutSRB/tap
  brew trust --cask barutsrb/tap/omniwm
  brew bundle --file="$DOT_DIR/Brewfile"

  tldr --update
}

main() {
  export PATH="$HOME/.local/bin:${DOT_DIR}:/opt/homebrew/bin:/usr/local/bin:$PATH"

  [ "$(uname)" = "Darwin" ] || die "Not a Mac. Quitting."
  xcode_cli_tools

  echo ""
  log "Starting mac setup..."
  echo ""
  sleep 1

  case "${1:-}" in
  packages | install)
    packages_install
    ;;
  config | sync)
    config_setup
    ;;
  '')
    packages_install
    nvim_config
    config_setup
    ;;
  brew)
    brew_install
    ;;
  upgrade)
    brew_upgrade
    ;;
  nvim)
    nvim_config
    ;;
  *)
    echo "Usage: $0 [config|install|packages|brew|upgrade|nvim]"
    exit 1
    ;;
  esac

  echo ""
  log "mac setup complete!"
  echo ""
}

main "$@"
