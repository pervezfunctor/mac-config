#!/bin/sh

set -eu

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

frm() {
  if [ -e "$1" ]; then
    log "Trashing $1..."
    trash "$1"
  fi
}

readonly REPO_NAME="mac-config"
readonly DOT_DIR="$HOME/.${REPO_NAME}"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

log() { printf "${GREEN}✔${RESET} %s\n\n" "$*"; }
warn() { printf "${YELLOW}${BOLD}⚠${RESET} %s\n\n" "$*" >&2; }
die() {
  printf "${RED}${BOLD}✖${RESET} %s\n\n" "$*" >&2
  exit 1
}

brew_upgrade() {
  has_cmd brew || die "brew not found."
  log "Upgrading brew packages..."
  brew upgrade -y
}

brew_install() {
  if has_cmd brew; then
    log "Updating brew..."
    brew_upgrade
    return
  fi

  log "Installing homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
}

zsh_config() {
  if [ -L ~/.zshrc ] && [ ! -e ~/.zshrc ]; then
    rm ~/.zshrc
  fi
  touch ~/.zshrc
  readonly snippet="for file in ~/.config/zsh/conf.d/*.zsh(N); do source \"\$file\"; done"
  if ! grep -qF "$snippet" ~/.zshrc; then
    log "Sourcing ~/.config/zsh/conf.d/*.zsh in ${HOME}/.zshrc"
    echo "$snippet" >>~/.zshrc
  fi
}

nvim_config() {
  has_cmd nvim || brew install -y -q neovim

  if [ ! -e ~/.config/nvim/init.lua ]; then
    frm ~/.config/nvim
    log "Cloning Astronvim..."
    git clone --depth 1 https://github.com/AstroNvim/template ~/.config/nvim
    frm ~/.config/nvim/.git
    frm ~/.local/share/nvim
    frm ~/.local/state/nvim
    frm ~/.cache/nvim
    log "Astronvim installed."
  else
    log "$HOME/.config/nvim already exists. Skipping installation."
  fi
}

sync_config() {
  has_cmd rsync || {
    has_cmd brew || die "brew not found."
    log "Installing rsync..."
    brew install -y -q rsync
  }

  REL_PATH="${1:?Usage: sync_config <rel_path> <dest_dir>}"
  DEST="${2:?Usage: sync_config <rel_path> <dest_dir>}"
  : "${DOT_DIR:?DOT_DIR is not set}"
  SRC="$DOT_DIR/$REL_PATH"

  [ -d "$SRC" ] || die "Source not found: $SRC"

  backup_base="$HOME/.mac-config-backup"
  BACKUP_TIMESTAMP="$backup_base/$(date +%Y-%m-%d_%H-%M-%S)"

  log "Syncing $REL_PATH/ -> $DEST/"
  rsync -ah -b --backup-dir="$BACKUP_TIMESTAMP/$REL_PATH" "$SRC/" "$DEST/"
  log "Backup: $BACKUP_TIMESTAMP/$REL_PATH"
}

config_setup() {
  sync_config config "$HOME/.config"

  zsh_config

  if has_cmd code && ! code --list-extensions | grep -qi "catppuccin.catppuccin-vsc"; then
    code --install-extension "catppuccin.catppuccin-vsc"
  fi

  if has_cmd kitten; then
    kitten themes --reload-in=none "Catppuccin-Mocha"
  fi

  if [ -e "$HOME/Library/Application Support/Code/User/settings.json" ]; then
    log "Copying vscode settings.json..."
    sync_config vscode "$HOME/Library/Application Support/Code/User"
  fi
}

packages_install() {
  brew_install
  brew tap BarutSRB/tap
  brew trust --cask barutsrb/tap/omniwm
  brew bundle --file="$DOT_DIR/Brewfile"

  tldr --update
}

main() {
  export PATH="$HOME/.local/bin:${DOT_DIR}:/opt/homebrew/bin:/usr/local/bin:$PATH"

  [ "$(uname)" = "Darwin" ] || die "Not a Mac. Quitting."

  echo ""
  log "Starting mac setup..."
  echo ""
  sleep 1

  case "${1:-}" in
  packages | install)
    packages_install
    ;;
  config | sync)
    config_setup
    ;;
  '')
    packages_install
    nvim_config
    config_setup
    ;;
  brew)
    brew_install
    ;;
  nvim)
    nvim_config
    ;;
  *)
    echo "Usage: $0 [config|install|brew|nvim]"
    exit 1
    ;;
  esac

  echo ""
  log "mac setup complete!"
  echo ""
}

main "$@"
