#!/bin/sh

set -eu

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

frm() {
  if [ -e "$1" ]; then
    log "Trashing $1..."
    trash "$1"
  fi
}

readonly REPO_NAME="mac-config"
readonly DOT_DIR="$HOME/.${REPO_NAME}"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

log() { printf "${GREEN}✔${RESET} %s\n\n" "$*"; }
warn() { printf "${YELLOW}${BOLD}⚠${RESET} %s\n\n" "$*" >&2; }
die() {
  printf "${RED}${BOLD}✖${RESET} %s\n\n" "$*" >&2
  exit 1
}

brew_install() {
  if has_cmd brew; then
    log "Updating brew..."
    brew update
    brew upgrade -y
    return
  fi

  log "Installing homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
}

zsh_config() {
  touch ~/.zshrc
  readonly snippet="for file in ~/.config/zsh/conf.d/*.zsh(N); do source \"\$file\"; done"
  if ! grep -qF "$snippet" ~/.zshrc; then
    log "Sourcing ~/.config/zsh/conf.d/*.zsh in ${HOME}/.zshrc"
    echo "$snippet" >>~/.zshrc
  fi
}

nvim_config() {
  has_cmd nvim || brew install -y -q nvim
  if [ ! -d ~/.config/nvim ]; then
    log "Cloning Astronvim..."
    git clone --depth 1 https://github.com/AstroNvim/template ~/.config/nvim
    frm ~/.config/nvim/.git
    frm ~/.local/share/nvim
    frm ~/.local/state/nvim
    frm ~/.cache/nvim
    log "Astronvim installed."
  else
    log "$HOME/.config/nvim already exists. Skipping installation."
  fi
}

sync_config() {
  has_cmd rsync || {
    has_cmd brew || die "brew not found."
    log "Installing rsync..."
    brew install -y -q rsync
  }

  readonly REL_PATH="${1:?Usage: sync_config <rel_path> <dest_dir>}"
  readonly DEST="${2:?Usage: sync_config <rel_path> <dest_dir>}"
  : "${DOT_DIR:?DOT_DIR is not set}"
  readonly SRC="$DOT_DIR/$REL_PATH"

  [ -d "$SRC" ] || die "Source not found: $SRC"

  readonly backup_base="${XDG_DATA_HOME:-$HOME}/.mac-config-backup"
  BACKUP_TIMESTAMP="$backup_base/$(date +%Y-%m-%d_%H-%M-%S)"

  log "Syncing $REL_PATH/ -> $DEST/"
  rsync -ah -b --backup-dir="$BACKUP_TIMESTAMP/$REL_PATH" "$SRC/" "$DEST/"
  log "Backup: $BACKUP_TIMESTAMP/$REL_PATH"
}

config_setup() {
  sync_config config "$HOME/.config"
  zsh_config

  has_cmd kitten || return 0
  kitten themes "Ayu Mirage"
  kitten themes "Catppuccin-Mocha"
}

vscode_config() {
  log "Installing VSCode extensions..."
  for ext in \
    "Catppuccin.catppuccin-vsc" \
    "charliermarsh.ruff" \
    "llvm-vs-code-extensions.vscode-clangd" \
    "marimo-team.vscode-marimo" \
    "ms-python.debugpy" \
    "ms-python.python" \
    "ms-python.vscode-python-envs" \
    "ms-toolsai.jupyter" \
    "ms-vscode.cmake-tools" \
    "ms-vscode.cpptools" \
    "rust-lang.rust-analyzer"; do
    code --install-extension "$ext"
  done
  log "VSCode extensions installed."
}

packages_install() {
  brew_install
  brew tap BarutSRB/tap
  brew trust --cask barutsrb/tap/omniwm
  brew bundle --file="$DOT_DIR/Brewfile"

  vscode_config
  tldr --update
  nvim_config
}

main() {
  export PATH="$HOME/.local/bin:${DOT_DIR}:/opt/homebrew/bin:/usr/local/bin:$PATH"

  [ "$(uname)" = "Darwin" ] || die "Not a Mac. Quitting."

  echo ""
  log "Starting mac setup..."
  echo ""

  case "${1:-}" in
  config | sync)
    shift
    config_setup
    ;;
  brew)
    shift
    brew_install
    ;;
  packages | install)
    packages_install
    ;;
  '')
    packages_install
    config_setup
    ;;
  *)
    echo "Usage: $0 [config|install|brew]"
    exit 1
    ;;
  esac

  echo ""
  log "mac setup complete!"
  echo ""
}

main "$@"
